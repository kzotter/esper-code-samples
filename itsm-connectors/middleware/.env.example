# Esper ITSM Connector Middleware — Configuration
# Copyright (c) 2026 Esper.io — MIT License
#
# Copy this file to .env and fill in your values.

# ── Required ──────────────────────────────────────────────────────────────────

# Your Esper tenant name (the "acme" part of acme.esper.cloud)
ESPER_TENANT=

# Esper API key — scope this to a support RBAC role with minimal permissions.
# Generate in: Esper Console → API Key Management
# NEVER commit this value to source control.
ESPER_API_KEY=

# Enterprise UUID — found in the Esper Console under API Key Management.
ESPER_ENTERPRISE_ID=

# ── Optional ──────────────────────────────────────────────────────────────────

# Server port (default: 3000)
# PORT=3000

# Comma-separated list of allowed CORS origins.
# In production, set this to your ITSM platform's domain(s).
# Example: https://yourco.zendesk.com,https://yourco.my.salesforce.com
# Default: * (allow all — NOT recommended for production)
# ALLOWED_ORIGINS=*

# Logging level — "dev" (colored, concise), "combined" (Apache-style), "short"
# LOG_LEVEL=dev

# Dry-run mode — set to "true" to validate commands without executing them.
# Recommended for initial setup and testing.
# DRY_RUN=false
